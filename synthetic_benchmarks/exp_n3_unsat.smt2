; Exp benchmark (n=3): 1 merge, 14 congruences (exponential cascade)
; UNSAT: a=b cascades through 3 layers of 2 functions each
(set-logic QF_UF)
(declare-sort U 0)
(declare-fun f0 (U) U)
(declare-fun f1 (U) U)
(declare-fun f2 (U) U)
(declare-fun f3 (U) U)
(declare-fun f4 (U) U)
(declare-fun f5 (U) U)
(declare-fun g (U U) U)
(declare-const a U)
(declare-const b U)
(declare-const ta1_0 U)
(assert (= ta1_0 (f0 a)))
(declare-const tb1_0 U)
(assert (= tb1_0 (f0 b)))
(declare-const ta1_1 U)
(assert (= ta1_1 (f1 a)))
(declare-const tb1_1 U)
(assert (= tb1_1 (f1 b)))
(declare-const ta2_0 U)
(assert (= ta2_0 (f2 ta1_0)))
(declare-const ta2_1 U)
(assert (= ta2_1 (f2 ta1_1)))
(declare-const tb2_0 U)
(assert (= tb2_0 (f2 tb1_0)))
(declare-const tb2_1 U)
(assert (= tb2_1 (f2 tb1_1)))
(declare-const ta2_2 U)
(assert (= ta2_2 (f3 ta1_0)))
(declare-const ta2_3 U)
(assert (= ta2_3 (f3 ta1_1)))
(declare-const tb2_2 U)
(assert (= tb2_2 (f3 tb1_0)))
(declare-const tb2_3 U)
(assert (= tb2_3 (f3 tb1_1)))
(declare-const ta3_0 U)
(assert (= ta3_0 (f4 ta2_0)))
(declare-const ta3_1 U)
(assert (= ta3_1 (f4 ta2_1)))
(declare-const ta3_2 U)
(assert (= ta3_2 (f4 ta2_2)))
(declare-const ta3_3 U)
(assert (= ta3_3 (f4 ta2_3)))
(declare-const tb3_0 U)
(assert (= tb3_0 (f4 tb2_0)))
(declare-const tb3_1 U)
(assert (= tb3_1 (f4 tb2_1)))
(declare-const tb3_2 U)
(assert (= tb3_2 (f4 tb2_2)))
(declare-const tb3_3 U)
(assert (= tb3_3 (f4 tb2_3)))
(declare-const ta3_4 U)
(assert (= ta3_4 (f5 ta2_0)))
(declare-const ta3_5 U)
(assert (= ta3_5 (f5 ta2_1)))
(declare-const ta3_6 U)
(assert (= ta3_6 (f5 ta2_2)))
(declare-const ta3_7 U)
(assert (= ta3_7 (f5 ta2_3)))
(declare-const tb3_4 U)
(assert (= tb3_4 (f5 tb2_0)))
(declare-const tb3_5 U)
(assert (= tb3_5 (f5 tb2_1)))
(declare-const tb3_6 U)
(assert (= tb3_6 (f5 tb2_2)))
(declare-const tb3_7 U)
(assert (= tb3_7 (f5 tb2_3)))
(assert (= a b))
(assert (not (= (g (g (g ta3_0 ta3_1) (g ta3_2 ta3_3)) (g (g ta3_4 ta3_5) (g ta3_6 ta3_7))) (g (g (g tb3_0 tb3_1) (g tb3_2 tb3_3)) (g (g tb3_4 tb3_5) (g tb3_6 tb3_7))))))
(check-sat)
