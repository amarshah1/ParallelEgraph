; Exp benchmark (n=1): 1 merge, 2 congruences (exponential cascade)
; UNSAT: a=b cascades through 1 layers of 2 functions each
(set-logic QF_UF)
(declare-sort U 0)
(declare-fun f0 (U) U)
(declare-fun f1 (U) U)
(declare-fun g (U U) U)
(declare-const a U)
(declare-const b U)
(declare-const ta1_0 U)
(assert (= ta1_0 (f0 a)))
(declare-const tb1_0 U)
(assert (= tb1_0 (f0 b)))
(declare-const ta1_1 U)
(assert (= ta1_1 (f1 a)))
(declare-const tb1_1 U)
(assert (= tb1_1 (f1 b)))
(assert (= a b))
(assert (not (= (g ta1_0 ta1_1) (g tb1_0 tb1_1))))
(check-sat)
