#!/bin/bash
#SBATCH -N 1
#SBATCH -t 12:00:00
#SBATCH --ntasks-per-node=128
#SBATCH --partition=RM-small


# type 'man sbatch' for more information and options
# this job will ask for 1 full RM node (128 cores) for 8 hours
# this job would potentially charge 1024 RM SUs

#echo commands to stdout
set -x

# move to working directory
# this job assumes:
# - all input data is stored in this directory
# - all output should be stored in this directory
# - please note that groupname should be replaced by your groupname
# - PSC-username should be replaced by your PSC username
# - path-to-directory should be replaced by the path to your directory where the executable is

cd /ocean/projects/cis230065p/ashah12/ParallelEgraph

# Load GCC 13 for GLIBCXX_3.4.29+ support
module load gcc/13.3.1-p20240614

# Use miniconda Python 3.12 (bench.py uses PEP 604 `X | Y` type hints, requires 3.10+)
export PATH="/jet/home/ashah12/miniconda3/bin:$PATH"

# Z3 configuration for Rust
export Z3_SYS_Z3_HEADER="/jet/home/ashah12/miniconda3/lib/python3.12/site-packages/z3/include/z3.h"
export LD_LIBRARY_PATH="/opt/packages/gcc/v13.3.1-p20240614/b2rm/lib64:/jet/home/ashah12/miniconda3/lib/python3.12/site-packages/z3/lib:$LD_LIBRARY_PATH"
export RUSTFLAGS="-L /jet/home/ashah12/miniconda3/lib/python3.12/site-packages/z3/lib"

export PYTHONUNBUFFERED=1
stdbuf -oL -eL  python3 run_all_benchmarks.py --threads-sweep 1,2,4,8,16,32,64,128 --egg-timeout 120
